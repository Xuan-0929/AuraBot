{
  "name": "aurabot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Desktop-first companion AI MVP with chat, timing, memory, and task foundations.",
  "main": "out/main/index.js",
  "productName": "AuraBot",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "electron-rebuild -f -w better-sqlite3 && electron-vite dev",
    "dev:clean": "node scripts/run-clean.mjs dev",
    "start:clean": "corepack pnpm build && node scripts/run-clean.mjs start",
    "build": "tsc --noEmit && electron-vite build",
    "package:mac": "node scripts/package-macos.mjs",
    "package:win": "corepack pnpm build && electron-builder --win nsis --x64",
    "rebuild:node": "corepack pnpm rebuild better-sqlite3",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "typecheck": "tsc --noEmit",
    "test": "corepack pnpm rebuild:node && vitest run",
    "test:unit": "corepack pnpm rebuild:node && vitest run tests/unit",
    "test:integration": "corepack pnpm rebuild:node && vitest run tests/integration",
    "test:e2e": "electron-rebuild -f -w better-sqlite3 && electron-vite build && playwright test",
    "eval:memory": "corepack pnpm rebuild:node && vitest run tests/unit/core/memory/memoryEvaluation.spec.ts"
  },
  "dependencies": {
    "@iconify-json/solar": "^1.2.5",
    "@iconify/vue": "^5.0.1",
    "@langchain/openai": "^1.4.5",
    "@vueuse/core": "^14.3.0",
    "@wxperia/liquid-glass-vue": "^1.0.9",
    "better-sqlite3": "^12.9.0",
    "live2dcubismcore": "1.0.2",
    "p-queue": "^9.2.0",
    "pinia": "^3.0.4",
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "6.5.10",
    "vue": "^3.5.34",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.59.1",
    "@swc/core": "^1.15.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.25",
    "@vitejs/plugin-vue": "^6.0.6",
    "electron": "^41.5.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "jsdom": "^28.0.1",
    "typescript": "^6.0.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.5"
  },
  "build": {
    "appId": "com.xuan.aurabot",
    "productName": "AuraBot",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "npmRebuild": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
