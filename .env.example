# AuraBot model API keys
#
# Copy this file to .env and replace each placeholder with the API key used by
# that model role. Never commit the resulting .env file.
#
# The Python backend reads process environment variables. Before starting
# AuraBot from a shell, export the values from .env, for example:
#
#   set -a
#   source .env
#   set +a

# Fluent responses for normal chat messages.
AURABOT_CHAT_MODEL_API_KEY=replace-with-chat-model-api-key

# Fast model used by the gateway.
AURABOT_GATEWAY_MODEL_API_KEY=replace-with-gateway-model-api-key

# Reasoning model used to execute tasks.
AURABOT_TASK_MODEL_API_KEY=replace-with-task-model-api-key
