{
  "name": "aurabot-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AuraBot desktop workspace.",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "pnpm --filter @aurabot/frontend dev",
    "dev:backend": "python -m uvicorn app.gateway.main:app --host 127.0.0.1 --port 6401 --app-dir backend",
    "dev:desktop": "pnpm --filter @aurabot/desktop dev",
    "dev:clean": "node scripts/run-clean.mjs dev",
    "start:clean": "pnpm build && node scripts/run-clean.mjs start",
    "build": "pnpm typecheck && pnpm --filter @aurabot/desktop build",
    "package:mac": "node scripts/package-macos.mjs",
    "package:win": "pnpm build && pnpm --filter @aurabot/desktop package:win",
    "rebuild:node": "pnpm --filter @aurabot/desktop rebuild:node",
    "rebuild:native": "pnpm --filter @aurabot/desktop rebuild:native",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "test": "pnpm rebuild:node && vitest run --config configs/vitest.config.ts",
    "test:unit": "pnpm rebuild:node && vitest run --config configs/vitest.config.ts tests/unit",
    "test:integration": "pnpm rebuild:node && vitest run --config configs/vitest.config.ts tests/integration",
    "test:e2e": "pnpm --filter @aurabot/desktop rebuild:native && pnpm --filter @aurabot/desktop build && playwright test --config configs/playwright.config.ts",
    "eval:memory": "pnpm rebuild:node && vitest run --config configs/vitest.config.ts tests/unit/core/memory/memoryEvaluation.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@swc/core": "^1.15.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.25",
    "@vitejs/plugin-vue": "^6.0.6",
    "electron": "^41.5.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "jsdom": "^28.0.1",
    "pinia": "^3.0.4",
    "typescript": "^6.0.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.5",
    "vue": "^3.5.34"
  }
}
